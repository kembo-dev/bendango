DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-locally
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# LLM: bedrock or ollama
LLM_PROVIDER=ollama
LLM_MODEL=google.gemma-3-12b-it

# AWS Bedrock (only when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Search
DEFAULT_SEARCH_COUNTRY=RDC
LOCAL_SEARCH_DOMAINS=drcmart.com,mobile-rdc.com
LISTING_STALE_DAYS=30

# FX: units of currency for 1 USD. Replace with current rates in production.
FX_CDF_PER_USD=2800
FX_EUR_PER_USD=0.86

# Database: omit DB_ENGINE to use local SQLite.
# DB_ENGINE=postgresql
# DB_NAME=bendango
# DB_USER=bendango
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
